[
  {
    "label": "CMake: build release",
    "command": "cmake --preset release && cmake --build --preset release",
    "hide": "on_success",
  },
  {
    "label": "CMake: build debug",
    "command": "cmake --preset debug && cmake --build --preset debug",
    "hide": "on_success",
  },
  {
    "label": "CMake: run",
    "command": "cmake --preset release && cmake --build --preset release && ./build/release/grocery",
    "hide": "on_success",
    "use_new_terminal": true,
  },
  {
    "label": "CMake: debug run",
    "command": "cmake --preset debug && cmake --build --preset debug && ./build/debug/grocery",
    "hide": "never",
    "use_new_terminal": true,
  },
  {
    "label": "CMake: docs",
    "command": "cmake --preset release && cmake --build --preset release --target docs",
    "hide": "on_success",
  },
  {
    "label": "CMake: diagrams",
    "command": "cmake --preset release && cmake --build --preset release --target diagrams",
    "hide": "on_success",
  },
  {
    "label": "CMake: clean release",
    "command": "rm -rf build/release",
    "hide": "on_success",
  },
  {
    "label": "CMake: clean debug",
    "command": "rm -rf build/debug",
    "hide": "on_success",
  },
  {
    "label": "CMake: clean all",
    "command": "rm -rf build",
    "hide": "on_success",
  },
]
