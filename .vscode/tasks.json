      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release", "--target", "docs"],
      "dependsOn": ["CMake: configure release"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
      },
    },
    {
      "label": "CMake: diagrams",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release", "--target", "diagrams"],
      "dependsOn": ["CMake: configure release"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
