{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure release",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "release"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
      },
    },
    {
      "label": "CMake: build release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "dependsOn": ["CMake: configure release"],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
      },
    },
    {
      "label": "CMake: configure debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
      },
    },
    {
      "label": "CMake: build debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "dependsOn": ["CMake: configure debug"],
      "group": {
        "kind": "build",
        "isDefault": true,
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
      },
    },
    {
