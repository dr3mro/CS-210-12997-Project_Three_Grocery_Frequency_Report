digraph GroceryClassDiagram {
    graph [
        bgcolor="white",
        rankdir=LR,
        splines=ortho,
        nodesep=0.55,
        ranksep=1.0,
        pad=0.25,
        labelloc="t",
        label="Grocery Frequency Report - Class Design",
        fontsize=22,
        fontname="Helvetica"
    ];

    node [
        shape=plain,
        fontname="Helvetica",
        fontsize=10
    ];

    edge [
        color="#566573",
        fontname="Helvetica",
        fontsize=9,
        arrowsize=0.75
    ];

    app_controller [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2874A6">
            <TR><TD BGCOLOR="#D6EAF8"><B>grocery::app::AppController</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ Run(): void</TD></TR>
        </TABLE>
    >];

    data_controller [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2874A6">
            <TR><TD BGCOLOR="#D6EAF8"><B>grocery::data::DataController</B></TD></TR>
            <TR><TD ALIGN="LEFT">- fileController: FileController</TD></TR>
            <TR><TD ALIGN="LEFT">- kvStore: KVStore&amp;</TD></TR>
            <TR><TD ALIGN="LEFT">- serializer: Serializer</TD></TR>
            <TR><TD ALIGN="LEFT">- presenter: DataPresenter</TD></TR>
            <TR><TD ALIGN="LEFT">+ LoadData(filename): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ SaveData(filename): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ FindItem(key): string</TD></TR>
            <TR><TD ALIGN="LEFT">+ ListItemsWithQuantities(): string</TD></TR>
            <TR><TD ALIGN="LEFT">+ GetItemsHistogram(): string</TD></TR>
        </TABLE>
    >];

    kvstore [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#7D3C98">
            <TR><TD BGCOLOR="#E8DAEF"><B>grocery::data::KVStore</B></TD></TR>
            <TR><TD ALIGN="LEFT">inherits std::map&lt;string, int&gt;</TD></TR>
            <TR><TD ALIGN="LEFT">- KVStore()</TD></TR>
            <TR><TD ALIGN="LEFT">+ Instance(): KVStore&amp;</TD></TR>
            <TR><TD ALIGN="LEFT">+ addItem(key): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ getItem(key): int</TD></TR>
            <TR><TD ALIGN="LEFT">+ getItemsWithQuantaties(): map</TD></TR>
        </TABLE>
    >];

    serializer [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2874A6">
            <TR><TD BGCOLOR="#D6EAF8"><B>grocery::data::Serializer</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ Serialize(store, data): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ Deserialize(store, data): void</TD></TR>
            <TR><TD ALIGN="LEFT">- IsWhitespace(character): bool</TD></TR>
        </TABLE>
    >];

    presenter [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2874A6">
            <TR><TD BGCOLOR="#D6EAF8"><B>grocery::data::DataPresenter</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ FormatItemWithQuantity(item, quantity): string</TD></TR>
            <TR><TD ALIGN="LEFT">+ FormatItemsWithQuantities(items): string</TD></TR>
            <TR><TD ALIGN="LEFT">+ FormatItemsHistogram(items): string</TD></TR>
        </TABLE>
    >];

    file_controller [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#239B56">
            <TR><TD BGCOLOR="#D5F5E3"><B>grocery::io::FileController</B></TD></TR>
            <TR><TD ALIGN="LEFT">- reader: Reader</TD></TR>
            <TR><TD ALIGN="LEFT">- writer: Writer</TD></TR>
            <TR><TD ALIGN="LEFT">+ ReadFromFile(filename, data): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ WriteToFile(filename, data): void</TD></TR>
        </TABLE>
    >];

    reader [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#239B56">
            <TR><TD BGCOLOR="#D5F5E3"><B>grocery::io::Reader</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ Read(filename, data): void</TD></TR>
        </TABLE>
    >];

    writer [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#239B56">
            <TR><TD BGCOLOR="#D5F5E3"><B>grocery::io::Writer</B></TD></TR>
            <TR><TD ALIGN="LEFT">+ Write(filename, data): void</TD></TR>
        </TABLE>
    >];

    ui_controller [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#CA6F1E">
            <TR><TD BGCOLOR="#FDEBD0"><B>grocery::ui::UIController</B></TD></TR>
            <TR><TD ALIGN="LEFT">- menu: Menu</TD></TR>
            <TR><TD ALIGN="LEFT">- dialog: Dialog</TD></TR>
            <TR><TD ALIGN="LEFT">+ cleanScreen(): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ CreateMenu(): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ ShowMenu(): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ ProcessUserChoice(): void</TD></TR>
        </TABLE>
    >];

    dialog [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#CA6F1E">
            <TR><TD BGCOLOR="#FDEBD0"><B>grocery::ui::Dialog</B></TD></TR>
            <TR><TD ALIGN="LEFT">- dataController: DataController</TD></TR>
            <TR><TD ALIGN="LEFT">+ FindItem(): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ ListItemsWithQuantities(): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ PrintHistogram(): void</TD></TR>
        </TABLE>
    >];

    menu [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#CA6F1E">
            <TR><TD BGCOLOR="#FDEBD0"><B>grocery::ui::Menu</B></TD></TR>
            <TR><TD ALIGN="LEFT">- items: vector&lt;Item&gt;</TD></TR>
            <TR><TD ALIGN="LEFT">+ addItem(text, action): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ ShowMenu(): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ GetMenuItemCount(): int</TD></TR>
            <TR><TD ALIGN="LEFT">+ getItem(index): Item*</TD></TR>
        </TABLE>
    >];

    item [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#CA6F1E">
            <TR><TD BGCOLOR="#FDEBD0"><B>grocery::ui::Item</B></TD></TR>
            <TR><TD ALIGN="LEFT">- text: string</TD></TR>
            <TR><TD ALIGN="LEFT">- action: function&lt;void()&gt;</TD></TR>
            <TR><TD ALIGN="LEFT">- index: int</TD></TR>
            <TR><TD ALIGN="LEFT">- nextIndex: int {static}</TD></TR>
            <TR><TD ALIGN="LEFT">+ GetText(): string&amp;</TD></TR>
            <TR><TD ALIGN="LEFT">+ ExecuteAction(): void</TD></TR>
            <TR><TD ALIGN="LEFT">+ PrintItem(): void</TD></TR>
        </TABLE>
    >];

    main [shape=ellipse, style="filled", fillcolor="#F4F6F7", color="#616A6B",
          label="main()"];

    main -> app_controller [label="creates"];
    app_controller -> data_controller [label="uses"];
    app_controller -> ui_controller [label="creates"];

    data_controller -> file_controller [label="owns"];
    data_controller -> kvstore [label="references singleton"];
    data_controller -> serializer [label="owns"];
    data_controller -> presenter [label="owns"];

    file_controller -> reader [label="owns"];
    file_controller -> writer [label="owns"];

    ui_controller -> menu [label="owns"];
    ui_controller -> dialog [label="owns"];
    dialog -> data_controller [label="owns"];
    menu -> item [label="contains 0..*"];

    kvstore -> std_map [style=invis];
    std_map [shape=note, style="filled", fillcolor="#F5EEF8", color="#7D3C98",
             label="std::map<string, int>\nbase class"];
    kvstore -> std_map [arrowhead="empty", label="inherits"];
}
