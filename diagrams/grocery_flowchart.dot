digraph GroceryApplicationFlow {
    graph [
        bgcolor="white",
        fontname="Helvetica",
        rankdir=TB,
        nodesep=0.45,
        ranksep=0.55,
        pad=0.25,
        labelloc="t",
        label="Grocery Frequency Report - Application Flow",
        fontsize=22
    ];

    node [
        shape=box,
        style="rounded,filled",
        fillcolor="#EAF2F8",
        color="#2874A6",
        fontname="Helvetica",
        fontsize=11,
        margin="0.16,0.10"
    ];

    edge [
        color="#566573",
        fontname="Helvetica",
        fontsize=10,
        arrowsize=0.75
    ];

    start [shape=oval, fillcolor="#D5F5E3", color="#239B56", label="Start"];
    controller [label="Get shared DataController\nsingleton instance"];
    load [label="Read CS210_Project_Three_Input_File.txt"];
    file_ok [shape=diamond, style="filled", fillcolor="#FCF3CF", color="#B7950B",
             label="Input file opened?"];
    load_error [label="Display file error\nand wait for Enter", fillcolor="#FADBD8", color="#C0392B"];
    count [label="Deserialize each non-empty line\nand increment KVStore counts"];
    serialize [label="Serialize item counts"];
    save [label="Write frequency.dat"];
    save_ok [shape=diamond, style="filled", fillcolor="#FCF3CF", color="#B7950B",
             label="Output file opened?"];
    save_error [label="Display file error\nand wait for Enter", fillcolor="#FADBD8", color="#C0392B"];
    create_menu [label="Create menu actions:\nFind item, List quantities,\nPrint histogram, Exit"];
    show_menu [label="Clear screen and display menu"];
    prompt [label="Prompt for menu choice"];
    input_ok [shape=diamond, style="filled", fillcolor="#FCF3CF", color="#B7950B",
              label="Input received?"];
    quit [shape=diamond, style="filled", fillcolor="#FCF3CF", color="#B7950B",
          label="Choice is q or Q?"];
    validate [label="Parse complete numeric choice"];
    valid [shape=diamond, style="filled", fillcolor="#FCF3CF", color="#B7950B",
           label="Choice is 1-4?"];
    invalid [label="Display invalid-choice message", fillcolor="#FADBD8", color="#C0392B"];
    dispatch [shape=diamond, style="filled", fillcolor="#FCF3CF", color="#B7950B",
              label="Selected action"];
    find_prompt [label="Prompt for item name"];
    find_quit [shape=diamond, style="filled", fillcolor="#FCF3CF", color="#B7950B",
               label="Item input starts with q?"];
    find_result [label="Look up item in KVStore\nand display quantity"];
    list [label="Format and display\nall item quantities"];
    histogram [label="Format and display\nasterisk histogram"];
    pause [label="Wait for Enter"];
    redraw [label="Return to menu and redraw"];
    exit [shape=oval, fillcolor="#D5F5E3", color="#239B56", label="Exit"];

    start -> controller;
    controller -> load;
    load -> file_ok;
    file_ok -> load_error [label="No"];
    file_ok -> count [label="Yes"];
    load_error -> count [label="Continue with empty input"];
    count -> serialize;
    serialize -> save;
    save -> save_ok;
    save_ok -> save_error [label="No"];
    save_ok -> create_menu [label="Yes"];
    save_error -> create_menu;
    create_menu -> show_menu;
    show_menu -> prompt;
    prompt -> input_ok;
    input_ok -> exit [label="No / EOF"];
    input_ok -> quit [label="Yes"];
    quit -> exit [label="Yes"];
    quit -> validate [label="No"];
    validate -> valid;
    valid -> invalid [label="No"];
    invalid -> prompt;
    valid -> dispatch [label="Yes"];

    dispatch -> find_prompt [label="1"];
    dispatch -> list [label="2"];
    dispatch -> histogram [label="3"];
    dispatch -> exit [label="4"];

    find_prompt -> find_quit;
    find_quit -> redraw [label="Yes"];
    find_quit -> find_result [label="No"];
    find_result -> find_prompt;
    list -> pause;
    histogram -> pause;
    pause -> redraw;
    redraw -> show_menu;
}
